#include <winres.h>

1 ICON "@GGZIP_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE @GGZIP_RESOURCE_TYPE@
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@GGZIP_RESOURCE_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "ProductName", "ggZip"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
            VALUE "OriginalFilename", "@GGZIP_RESOURCE_FILENAME@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
