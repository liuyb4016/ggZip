// ggZip Shell 扩展资源：图标 + 版本信息
#include <winres.h>

1 ICON "res\\ggzip.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ggZip Shell Extension"
            VALUE "FileVersion", "0.2.0.0"
            VALUE "ProductName", "ggZip"
            VALUE "ProductVersion", "0.2.0.0"
            VALUE "OriginalFilename", "ggzip_shell.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
